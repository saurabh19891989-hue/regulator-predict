{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "audit.schema.json",
 "title": "leakage_audit_verdict",
 "version": "1.0.0",
 "type": "object",
 "required": [
  "audit_id",
  "thread_id",
  "scope",
  "verdict",
  "findings",
  "auditor",
  "audit_date"
 ],
 "properties": {
  "audit_id": {
   "type": "string"
  },
  "thread_id": {
   "type": "string"
  },
  "scope": {
   "enum": [
    "thread",
    "snapshot",
    "evidence_item"
   ]
  },
  "snapshot_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "evidence_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "verdict": {
   "enum": [
    "clean",
    "minor_issue_fixed",
    "contaminated_exclude",
    "contaminated_rebuild",
    "unverifiable"
   ]
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "auditor": {
   "type": "string"
  },
  "audit_date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 },
 "additionalProperties": true
}